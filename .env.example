# 数据库（不设置 DB_NAME 时自动回退到本地 SQLite）
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=family_finance
# DB_USER=root
# DB_PASSWORD=

# 也可以直接给出完整连接串，优先级最高
# DATABASE_URL=mysql+pymysql://root:yourpass@localhost:3306/family_finance?charset=utf8mb4

# Flask 会话密钥，生产环境务必更换
SECRET_KEY=change-me-to-a-random-string

# 部署到 HTTPS 后设为 1
SESSION_COOKIE_SECURE=0
